# Copy to .env.local and fill in. One OpenAI key runs both the voice and the panel writer.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# The voice model.
REALTIME_MODEL=gpt-realtime-2.1-mini
# marin and cedar are OpenAI's recommended voices.
REALTIME_VOICE=marin
# The model that writes generated panels (A2UI).
COMPOSER_MODEL=gpt-5.6-sol

# Optional, for `pnpm e2e:voice`: the synthesized caller's voice. Without a key it uses macOS `say`.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=iP95p4xoKVk53GoZ742B

# Turns off the CopilotKit runtime's usage telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true
