# Copy to .env.local and fill in. One OpenAI key runs both the voice and the UI writer.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# The voice model. gpt-realtime-2.1 is the step up if briefs come out thin.
REALTIME_MODEL=gpt-realtime-2.1-mini
# marin and cedar are OpenAI's recommended voices.
REALTIME_VOICE=marin
# The model that writes the UI (A2UI Express). gpt-6-astra is the step up; gpt-5.6-luna is the cheap one.
COMPOSER_MODEL=gpt-5.6-sol

# Turns off the CopilotKit runtime's usage telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true
